# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# PostgreSQL (bot uses SQLAlchemy async)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ai_parser
# Uncomment for local tests without PostgreSQL
# DATABASE_URL=sqlite+aiosqlite:///./ai_parser.db

# Docker Compose: credentials for the bundled PostgreSQL container
# (DATABASE_URL above is overridden by compose to point at the container)
POSTGRES_USER=finmind
POSTGRES_PASSWORD=finmind
POSTGRES_DB=finmind

# Financial data APIs
# Finnhub (https://finnhub.io) - free: 60 requests/min, for stocks
FINNHUB_API_KEY=
# CoinGecko Demo (https://www.coingecko.com/en/api) - free: 100 req/min, 10k/month
COINGECKO_API_KEY=
# OpenRouter (https://openrouter.ai) for AI-agent (/analyze)
OPENROUTER_API_KEY=

# Admin (Telegram user ID) for critical-action notifications
ADMIN_ID=

# Bot behavior (optional)
RATE_LIMIT_PER_MINUTE=10
CACHE_TTL_FX_SECONDS=3600
CACHE_TTL_STOCK_SECONDS=600
CACHE_TTL_FUNDAMENTAL_SECONDS=1800
# Bot language: "en" (default) or "ru"
DEFAULT_LANGUAGE=en

# AI-agent (optional)
# Free OpenRouter model; the :free catalog changes — check openrouter.ai/models
OPENROUTER_MODEL=nvidia/nemotron-3-nano-30b-a3b:free
OPENROUTER_MAX_TOKENS=1200