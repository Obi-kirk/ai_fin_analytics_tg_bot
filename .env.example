# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# PostgreSQL (bot uses SQLAlchemy async)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ai_parser
# Uncomment for local tests without PostgreSQL
# DATABASE_URL=sqlite+aiosqlite:///./ai_parser.db

# Financial data APIs
# FCS API (https://fcsapi.com) - free plan: 500 requests/month
FCS_API_KEY=
# Finnhub (https://finnhub.io) - free: 60 requests/min, для акций
FINNHUB_API_KEY=
# CoinGecko Demo (https://www.coingecko.com/en/api) - free: 100 req/min, 10k/мес
COINGECKO_API_KEY=
# OpenRouter (https://openrouter.ai) for AI-agent (/analyze)
OPENROUTER_API_KEY=
# Optional: Groq instead of OpenRouter
# GROQ_API_KEY=

# Admin (Telegram user ID) for critical-action notifications
ADMIN_ID=

# Bot behavior (optional)
RATE_LIMIT_PER_MINUTE=10
CACHE_TTL_FX_SECONDS=3600
CACHE_TTL_STOCK_SECONDS=600

# AI-agent (optional)
# Бесплатная модель OpenRouter; каталог :free меняется — смотрите openrouter.ai/models
OPENROUTER_MODEL=nvidia/nemotron-3-nano-30b-a3b:free
OPENROUTER_MAX_TOKENS=700